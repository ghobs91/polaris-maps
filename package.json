{
  "name": "polaris-maps",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:open": "xed ios",
    "ios:pods": "cd ios && bundle exec pod install",
    "ios:beta": "bundle exec fastlane ios beta",
    "ios:release": "bundle exec fastlane ios release",
    "ios:validate": "bundle exec fastlane ios validate",
    "android": "expo run:android",
    "carplay:sim": "sh scripts/install-carplay-simulator.sh",
    "carplay:resign": "CARPLAY_SKIP_BUILD=1 sh scripts/install-carplay-simulator.sh",
    "carplay:doctor": "sh scripts/doctor-carplay-simulator.sh",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "test:contract": "jest --config jest.contract.config.js",
    "test:e2e:ios": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "test:benchmark": "jest --config jest.benchmark.config.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "mapkit:token": "node scripts/generate-mapkit-token.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prebuild": "expo prebuild --clean",
    "postinstall": "node scripts/patch-atproto-oauth.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@atproto/api": "^0.19.9",
    "@atproto/oauth-client-expo": "^0.1.8",
    "@babel/runtime": "7.28.6",
    "@expo/metro-runtime": "^57.0.7",
    "@expo/vector-icons": "15.1.1",
    "@mapbox/vector-tile": "^2.0.4",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@noble/curves": "1.8.0",
    "@noble/hashes": "1.8.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "7.3.0",
    "@react-navigation/native": "7.3.14",
    "@shopify/flash-list": "^2.0.2",
    "babel-preset-expo": "57.0.4",
    "bare-rpc": "1.2.0",
    "expo": "57.0.8",
    "expo-asset": "57.0.7",
    "expo-blur": "57.0.2",
    "expo-camera": "57.0.3",
    "expo-constants": "57.0.7",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "57.0.6",
    "expo-keep-awake": "57.0.1",
    "expo-linking": "57.0.4",
    "expo-location": "57.0.6",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "57.0.5",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.1",
    "expo-web-browser": "57.0.2",
    "geo-coordinates-parser": "^1.7.4",
    "gun": "0.2020.1240",
    "pako": "^2.1.0",
    "pbf": "^4.0.1",
    "pluscodes": "^3.0.1",
    "pmtiles": "^4.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-bare-kit": "0.13.3",
    "react-native-get-random-values": "1.11.0",
    "react-native-mmkv": "3.2.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@react-native-community/cli": "latest",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "expo-mcp": "~0.2.4",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.4.0",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
