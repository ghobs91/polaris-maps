# Traffic (optional). TomTom is a bounded cold-start bridge only — traffic
# works without it via P2P peers and free open feeds. Get a free key at
# https://developer.tomtom.com/ (leave blank to disable the bridge).
EXPO_PUBLIC_TOMTOM_API_KEY=

# Free open traffic feeds (optional, comma-separated URLs). No paid providers.
# Examples: NL NDW, US state DOT 511 / DATEX II endpoints you are licensed to use.
# EXPO_PUBLIC_OPEN_TRAFFIC_FEEDS=https://example.gov/traffic.json

# Overture Maps places PMTiles archive (optional). Defaults to the current
# Overture release; override only to pin a different release or self-host.
# Keep in sync with https://stac.overturemaps.org/catalog.json (`latest`).
# EXPO_PUBLIC_OVERTURE_PLACES_PM_TILES_URL=https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-09-23.1/places.pmtiles

# Transitous MOTIS 2 API (global transit routing, lines, and departures)
# Defaults to the public Transitous instance.
# Set to a custom URL for self-hosted instances.
# EXPO_PUBLIC_TRANSITOUS_BASE_URL=https://api.transitous.org/api

# WMATA API key (free, 1000 calls/day) — https://developer.wmata.com/
# EXPO_PUBLIC_WMATA_API_KEY=your_wmata_api_key_here

# Denmark orthophoto (optional). Free Dataforsyningen account credentials
# (https://dataforsyningen.dk/). The Denmark satellite layer is omitted unless
# both are set; no credential is committed to the repository.
# EXPO_PUBLIC_DK_DATAFORSYNING_USER=
# EXPO_PUBLIC_DK_DATAFORSYNING_PASSWORD=

# Finland orthophoto (optional). Free self-service API key from OmaTili:
# https://omatili.maanmittauslaitos.fi/ (open interface services). The Finland
# satellite layer is omitted unless set.
# EXPO_PUBLIC_FI_MML_API_KEY=

# Mapillary client token (optional) — street-level 3D imagery.
# Explicit exception to the no-corporate-cloud rule: the Street View 3D viewer
# is hidden without a token and is online-only. Panoramax (open, no token) is
# always used to fill the gaps. Get a token at https://www.mapillary.com/dashboard/developers
# EXPO_PUBLIC_MAPILLARY_TOKEN=
