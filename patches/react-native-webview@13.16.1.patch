+#if defined(__IPHONE_OS_VERSION_MAX_ALLOWED) && __IPHONE_OS_VERSION_MAX_ALLOWED >= 270000 /* iOS 27 */
+/**
+ * Geolocation permissions: deny silently.
+ *
+ * WebKit asks the host app to decide before it forwards a page's geolocation
+ * request to the system, and its default answer is the per-origin prompt naming
+ * the website ("…www.tripadvisor.com… would like to use your current
+ * location"). This app's hidden WebViews load third-party pages only to read
+ * data already present in the DOM, so no page needs the device's location.
+ * Denying here is the same decision the user would make by tapping "Don't
+ * Allow", and keeps the scrape silent.
+ */
+- (void)                          webView:(WKWebView *)webView
+  requestGeolocationPermissionForOrigin:(WKSecurityOrigin *)origin
+                      initiatedByFrame:(WKFrameInfo *)frame
+                     decisionHandler:(void (^)(WKPermissionDecision decision))decisionHandler {
+  decisionHandler(WKPermissionDecisionDeny);
+}
+#endif
